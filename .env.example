# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Password for the /admin analytics dashboard (required to enable admin access)
ADMIN_PASSWORD=change-me

# Closed alpha: comma-separated list of valid access secrets. A visitor opens
# the app with /app?k=<secret>. Empty or unset disables the gate entirely and
# makes the app public -- that is how the alpha ends.
#
# Pick a secret that does NOT appear anywhere in the site's own content.
# netlify.toml publishes the whole repository (publish = "."), and Netlify's
# secrets scanning fails the build when the value of an environment variable
# is found in the published output. Anything on-brand is therefore the wrong
# choice: "longhorn", "veteran", "epping" and the like are all printed on the
# homepage. A two-word phrase unrelated to the copy works and is still easy to
# read out. Never commit the real value here.
ALPHA_SECRETS=change-me

# Mailing list (EmailOctopus). Required for /api/subscribe to store sign-ups.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=
