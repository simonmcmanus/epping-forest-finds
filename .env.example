# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# The /admin dashboard signs in with Auth0. ADMIN_SUBJECTS is a comma-separated list of Auth0
# subject ids (the "user_id" in Auth0, e.g. auth0|abc123,google-oauth2|123). Empty = nobody.
# Also needs AUTH0_DOMAIN, AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET and AUTH_SECRET (32+ chars).
# See docs/admin-sign-in.md.
ADMIN_SUBJECTS=

# Optional: password for scripts that call the admin API as "Authorization: Bearer <password>"
# (and for POST /api/community/delete). The dashboard itself no longer uses it.
ADMIN_PASSWORD=change-me

# Closed alpha: comma-separated list of valid access secrets. A visitor opens
# the app with /app?k=<secret>. Empty or unset disables the gate entirely and
# makes the app public -- that is how the alpha ends.
#
# Pick a secret that does NOT appear anywhere in the site's own content.
# netlify.toml publishes the whole repository (publish = "."), and Netlify's
# secrets scanning fails the build when the value of an environment variable
# is found in the published output. Anything on-brand is therefore the wrong
# choice: "longhorn", "veteran", "epping" and the like are all printed on the
# homepage. A two-word phrase unrelated to the copy works and is still easy to
# read out. Never commit the real value here.
ALPHA_SECRETS=change-me

# Mailing list (EmailOctopus). Required for /api/subscribe to store sign-ups.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# TfL Unified API app key. Optional but recommended -- /api/transport-departures
# works without it, but TfL rate-limits unauthenticated requests much harder,
# and the weekly ledger's scripts/report/tfl_transit_status.py got HTTP 403
# without one from shared GitHub runner IPs (set the TFL_APP_KEY repository
# secret too; blank is treated as unset). Register a key
# at https://api-portal.tfl.gov.uk and it's appended to every StopPoint/
# Arrivals/Search call.
TFL_APP_KEY=
