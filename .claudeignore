# Data files — large GeoJSON/JSON that are data, not code.
# AI assistants don't need to read these; the spec and code describe their shape.
data/*.geojson
data/*.json
data/*.overpass.json
data/*.overpassql

# Root-level data files (versioned or large)
Veteran_Tree_Register.json
Veteran_Tree_Register.enriched.with_named_trees.json

# Tracking logs
tracking/

# Script utilities (rarely relevant to app logic changes)
scripts/

# Assets and certificates
assets/
.local-certs/

# Veteran Tree Register raw source files
Veteran Tree Register/
Veteran Tree Register.zip

# Spec files are useful context — do NOT ignore spec/
