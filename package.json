{
  "name": "forest-finds",
  "version": "1.0.0",
  "private": true,
  "description": "Forest Finds map app with local data tools and Netlify deployment support",
  "scripts": {
    "dev": "node server.js",
    "tunnel": "./start-dev.sh",
    "regen:landmarks": "python3 scripts/regenerate_local_landmarks.py",
    "regen:landmarks:js": "node scripts/regenerate-local-landmarks.js",
    "regen:paths": "python3 scripts/regenerate_local_paths.py",
    "regen:paths:js": "node scripts/regenerate-local-paths.js",
    "regen:environment": "python3 scripts/regenerate_local_environment.py",
    "split:trees": "node scripts/split-veteran-trees.js",
    "netlify:dev": "npx netlify dev",
    "build": "node scripts/generate-reports-index.js",
    "test": "node test/forest-finds.test.js && node --test test/reports-index.test.js && npm run test:py",
    "test:e2e": "npx playwright test",
    "test:e2e:update": "npx playwright test --update-snapshots",
    "test:e2e:ui": "npx playwright test --ui",
    "test:py": "python3 -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.8",
    "simple-icons": "^16.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
