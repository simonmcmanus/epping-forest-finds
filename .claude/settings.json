{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(node -e ' *)",
      "Bash(python3 -c ' *)",
      "Skill(run)",
      "Skill(run:*)",
      "Bash(/usr/bin/gh --version)",
      "Bash(/opt/homebrew/bin/gh --version)",
      "Bash(node -e \"require\\('playwright'\\); console.log\\('playwright ok'\\)\")",
      "Bash(mkdir -p /tmp/onboarding-screenshots && npx playwright codegen --no-headless 2>/dev/null; echo \"done\")",
      "Bash(npm run *)",
      "Bash(awk -F: '{print NR, $1, $2}')",
      "Bash(git checkout *)",
      "Bash(node --test test/forest-finds.test.js > /tmp/out.txt 2>&1; grep -n \"tests \\\\|pass \\\\|fail \\\\|not ok\" /tmp/out.txt | tail -20)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(playwright-report/**)",
      "Read(test-results/**)",
      "Read(package-lock.json)",
      "Read(.local-certs/**)",
      "Read(.env)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  }
}
